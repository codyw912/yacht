#!/usr/bin/env bash
# Yacht contributor environment (devenv.nix).
#
# Secrets are NOT loaded here: devenv.yaml sets `secretspec: enable: false`,
# so `direnv allow` never contacts 1Password and never populates API keys.
# Scoped secrets are resolved around individual Yacht commands instead —
# see docs/reference/secrets.md.

eval "$(devenv direnvrc)"

use devenv
