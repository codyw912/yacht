{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yacht.dev/schemas/yacht.real-benchmark-runbook.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "regatta",
    "course",
    "agent",
    "secret_placeholders",
    "steps",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "yacht.real-benchmark-runbook.v1"
    },
    "regatta": {
      "type": "string",
      "minLength": 1
    },
    "course": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "secret_placeholders": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/secretPlaceholder"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "artifacts": {
      "$ref": "#/$defs/artifacts"
    }
  },
  "$defs": {
    "secretPlaceholder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source",
        "ref",
        "argument"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "argument": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "command",
        "artifacts"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "artifacts": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "course_handoff",
        "preflight",
        "preflight_evidence_report",
        "task_attempts",
        "task_attempt_scorecard",
        "candidate_patches",
        "runtime_instances",
        "benchmark_execution_plan",
        "benchmark_launcher_handoff",
        "benchmark_launch_result",
        "benchmark_grading_collection",
        "benchmark_scorecard",
        "benchmark_report",
        "real_benchmark_eval",
        "real_benchmark_runbook"
      ],
      "properties": {
        "course_handoff": {
          "type": "string",
          "minLength": 1
        },
        "preflight": {
          "$ref": "#/$defs/stringArray"
        },
        "preflight_evidence_report": {
          "type": "string",
          "minLength": 1
        },
        "task_attempts": {
          "$ref": "#/$defs/stringArray"
        },
        "task_attempt_scorecard": {
          "type": "string",
          "minLength": 1
        },
        "candidate_patches": {
          "$ref": "#/$defs/stringArray"
        },
        "runtime_instances": {
          "type": "string",
          "minLength": 1
        },
        "benchmark_execution_plan": {
          "type": "string",
          "minLength": 1
        },
        "benchmark_launcher_handoff": {
          "type": "string",
          "minLength": 1
        },
        "benchmark_launch_result": {
          "type": "string",
          "minLength": 1
        },
        "benchmark_grading_collection": {
          "type": "string",
          "minLength": 1
        },
        "benchmark_scorecard": {
          "type": "string",
          "minLength": 1
        },
        "benchmark_report": {
          "type": "string",
          "minLength": 1
        },
        "real_benchmark_eval": {
          "type": "string",
          "minLength": 1
        },
        "real_benchmark_runbook": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
