{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yacht.dev/schemas/yacht.task-attempt.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "regatta",
    "course",
    "comparison",
    "vessel",
    "model",
    "rigging",
    "runtime",
    "status",
    "task",
    "runtime_context",
    "prompt",
    "agent",
    "metrics",
    "secret_refs"
  ],
  "properties": {
    "schema": {
      "const": "yacht.task-attempt.v1"
    },
    "regatta": {
      "type": "string",
      "minLength": 1
    },
    "course": {
      "type": "string",
      "minLength": 1
    },
    "comparison": {
      "type": "string",
      "minLength": 1
    },
    "vessel": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "rigging": {
      "$ref": "#/$defs/stringArray"
    },
    "runtime": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "completed",
        "failed"
      ]
    },
    "task": {
      "$ref": "#/$defs/task"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "runtime_context": {
      "$ref": "#/$defs/runtimeContext"
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "$ref": "#/$defs/agent"
    },
    "metrics": {
      "$ref": "#/$defs/metrics"
    },
    "secret_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/secretRef"
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "difficulty"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "repo_url": {
          "type": "string",
          "minLength": 1
        },
        "base_commit": {
          "type": "string",
          "minLength": 1
        },
        "problem_statement": {
          "type": "string",
          "minLength": 1
        },
        "expect_response": {
          "$ref": "#/$defs/expectResponse"
        },
        "expect_tool_calls": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      }
    },
    "expectResponse": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": [
          "string",
          "boolean",
          "integer",
          "number"
        ]
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "yacht",
        "harness",
        "model",
        "runtime",
        "tools"
      ],
      "properties": {
        "yacht": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version"
          ],
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "harness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/nullableString"
            },
            "version": {
              "$ref": "#/$defs/nullableString"
            }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "configured",
            "resolved"
          ],
          "properties": {
            "configured": {
              "type": "string",
              "minLength": 1
            },
            "resolved": {
              "$ref": "#/$defs/nullableString"
            }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "backend",
            "image"
          ],
          "properties": {
            "backend": {
              "type": "string",
              "minLength": 1
            },
            "image": {
              "$ref": "#/$defs/nullableString"
            }
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "tools",
              "version",
              "source"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "tools": {
                "$ref": "#/$defs/stringArray"
              },
              "version": {
                "$ref": "#/$defs/nullableString"
              },
              "source": {
                "$ref": "#/$defs/nullableString"
              }
            }
          }
        }
      }
    },
    "nullableString": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "runtimeContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "temp_home",
        "workspace_path",
        "command_prefix",
        "command",
        "cleanup_paths"
      ],
      "properties": {
        "backend": {
          "type": "string",
          "minLength": 1
        },
        "harness": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "temp_home": {
          "type": "string",
          "minLength": 1
        },
        "workspace_path": {
          "type": "string",
          "minLength": 1
        },
        "command_prefix": {
          "$ref": "#/$defs/stringArray"
        },
        "command": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "cleanup_paths": {
          "$ref": "#/$defs/stringArray"
        },
        "setup_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "origin",
              "origin_name",
              "action",
              "target",
              "argv",
              "exit_code"
            ],
            "properties": {
              "origin": {
                "type": "string",
                "minLength": 1
              },
              "origin_name": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "argv": {
                "$ref": "#/$defs/stringArray"
              },
              "exit_code": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exit_code",
        "response",
        "tool_calls",
        "transcript_path"
      ],
      "properties": {
        "exit_code": {
          "type": "integer",
          "minimum": 0
        },
        "response": {
          "type": "string"
        },
        "tool_calls": {
          "$ref": "#/$defs/stringArray"
        },
        "transcript_path": {
          "type": "string",
          "minLength": 1
        },
        "tool_call_evidence": {
          "type": "string",
          "minLength": 1
        },
        "machine_evidence": {
          "type": "object",
          "properties": {
            "format": {
              "type": "string",
              "minLength": 1
            },
            "event_count": {
              "type": "integer",
              "minimum": 0
            },
            "api": {
              "type": "string",
              "minLength": 1
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "response_id": {
              "type": "string",
              "minLength": 1
            },
            "usage": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0
              }
            },
            "cost": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0
              }
            },
            "tool_calls": {
              "$ref": "#/$defs/stringArray"
            },
            "execution": {
              "$ref": "#/$defs/executionSummary"
            }
          }
        },
        "skill_stages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "skill",
              "available",
              "selected",
              "loaded",
              "evidence_source"
            ],
            "properties": {
              "skill": {
                "type": "string",
                "minLength": 1
              },
              "available": {
                "type": "string",
                "enum": ["observed", "absent", "unmeasured"]
              },
              "selected": {
                "type": "string",
                "enum": ["observed", "absent", "unmeasured"]
              },
              "loaded": {
                "type": "string",
                "enum": ["observed", "absent", "unmeasured"]
              },
              "evidence_source": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokens",
        "duration_seconds"
      ],
      "properties": {
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "secretRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source",
        "ref",
        "redacted"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "redacted": {
          "const": true
        }
      }
    },
    "executionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "mode",
        "max_turns",
        "message_timeout_seconds",
        "timeout_seconds",
        "session_ids",
        "messages",
        "captures",
        "valid",
        "model",
        "harness",
        "harness_version",
        "settings",
        "usage",
        "cost_usd"
      ],
      "properties": {
        "schema": {
          "const": "yacht.execution.v1"
        },
        "mode": {
          "enum": ["single", "retained"]
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1
        },
        "message_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "session_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "ended",
              "loops_started",
              "loops_completed",
              "continuation_possible",
              "started_at",
              "finished_at"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}(?![\\s\\S])"
              },
              "started_at": {
                "type": "string",
                "minLength": 1
              },
              "finished_at": {
                "type": "string",
                "minLength": 1
              },
              "ended": {
                "enum": ["natural", "cap", "timeout", "error"]
              },
              "loops_started": {
                "type": "integer",
                "minimum": 0
              },
              "loops_completed": {
                "type": "integer",
                "minimum": 0
              },
              "continuation_possible": {
                "type": "boolean"
              },
              "usage": {
                "type": "object",
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "cost_usd": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "captures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["after", "path", "status"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}-(?:0|[1-9][0-9]*)(?![\\s\\S])"
              },
              "after": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}(?![\\s\\S])"
              },
              "path": {
                "type": "string",
                "pattern": "^(?!\\.\\.?(?:/|(?![\\s\\S])))[^/\\\\\\u0000]+(?:/(?!\\.\\.?(?:/|(?![\\s\\S])))[^/\\\\\\u0000]+)*(?![\\s\\S])"
              },
              "status": {
                "enum": ["missing", "captured", "error"]
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
              },
              "artifact": {
                "type": "string",
                "minLength": 1
              },
              "error": {
                "type": "string",
                "minLength": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "captured"
                    }
                  },
                  "required": ["status"]
                },
                "then": {
                  "required": ["bytes", "sha256", "artifact"]
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "error"
                    }
                  },
                  "required": ["status"]
                },
                "then": {
                  "required": ["error"]
                }
              }
            ]
          }
        },
        "valid": {
          "type": "boolean"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "harness": {
          "type": "string",
          "minLength": 1
        },
        "harness_version": {
          "type": "string",
          "minLength": 1
        },
        "settings": {
          "type": "object"
        },
        "usage": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "cost_usd": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "ended": {
          "enum": ["natural", "cap", "timeout", "error"]
        },
        "handoff": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
