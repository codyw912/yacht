{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yacht.dev/schemas/yacht.run-index.v2.schema.json",
  "title": "YACHT Run Index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_kind",
    "status",
    "stage",
    "started_at",
    "updated_at",
    "config_path",
    "regatta",
    "course",
    "comparisons",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "yacht.run-index.v2"
    },
    "run_kind": {
      "enum": [
        "real-benchmark",
        "real-smoke",
        "benchmark-repetitions"
      ]
    },
    "status": {
      "enum": [
        "running",
        "complete",
        "blocked",
        "failed"
      ]
    },
    "stage": {
      "enum": [
        "starting",
        "preflight",
        "task-attempts",
        "launch",
        "grading",
        "scorecard",
        "repetitions",
        "aggregation",
        "complete"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "terminal_at": {
      "type": "string",
      "format": "date-time"
    },
    "config_path": {
      "type": "string",
      "minLength": 1
    },
    "regatta": {
      "type": "string",
      "minLength": 1
    },
    "course": {
      "type": "string",
      "minLength": 1
    },
    "comparisons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/comparison"
      }
    },
    "artifacts": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/artifact"
      }
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/child"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["complete", "blocked", "failed"]
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["terminal_at"]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "running"
          }
        },
        "required": ["status"]
      },
      "then": {
        "not": {
          "required": ["terminal_at"]
        }
      }
    }
  ],
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!\\.\\.?$)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+"
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "course",
        "vessels"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "course": {
          "type": "string",
          "minLength": 1
        },
        "vessels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "present"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "present": {
          "type": "boolean"
        }
      }
    },
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "status"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "status": {
          "enum": [
            "running",
            "complete",
            "blocked",
            "failed"
          ]
        }
      }
    }
  }
}
