{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yacht.dev/schemas/yacht.regatta.v1.schema.json",
  "title": "YACHT Regatta",
  "type": "object",
  "additionalProperties": false,
  "required": ["regatta", "course", "vessels"],
  "$defs": {
    "preflightCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "agent-prompt",
            "artifact",
            "command",
            "env",
            "mcp-server",
            "path-isolation",
            "tool-call"
          ]
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "env": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "expect_tool_calls": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      }
    },
    "preflightRecipe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean",
          "default": true
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/preflightCheck"
          },
          "default": []
        }
      },
      "default": {}
    }
  },
  "properties": {
    "regatta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "tasks"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "difficulty": {
                "type": "integer",
                "minimum": 1,
                "default": 1
              }
            }
          }
        },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "dataset", "split", "harness"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["swe-bench"]
            },
            "dataset": {
              "type": "string",
              "minLength": 1
            },
            "split": {
              "type": "string",
              "minLength": 1
            },
            "harness": {
              "type": "string",
              "enum": ["docker"]
            }
          }
        }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "failure_policy": {
          "type": "string",
          "enum": ["abort-group", "skip-vessel", "abort-regatta", "warn"],
          "default": "abort-group"
        }
      },
      "default": {}
    },
    "secrets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source"],
        "properties": {
          "source": {
            "type": "string",
            "enum": ["env", "file"]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "source": {
                  "const": "env"
                }
              }
            },
            "then": {
              "required": ["name"]
            }
          },
          {
            "if": {
              "properties": {
                "source": {
                  "const": "file"
                }
              }
            },
            "then": {
              "required": ["path"]
            }
          }
        ]
      },
      "default": {}
    },
    "runtimes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["backend", "command"],
        "properties": {
          "backend": {
            "type": "string",
            "enum": ["container", "host-nix"]
          },
          "flake": {
            "type": "string",
            "minLength": 1
          },
          "image": {
            "type": "string",
            "minLength": 1
          },
          "container_home": {
            "type": "string",
            "pattern": "^/",
            "default": "/home/yacht"
          },
          "container_workspace": {
            "type": "string",
            "pattern": "^/",
            "default": "/workspace"
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "default": {}
          },
          "required_secrets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "mounts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "preflight": {
            "$ref": "#/$defs/preflightRecipe"
          }
        }
      },
      "default": {}
    },
    "riggings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "install": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "default": {}
          },
          "required_secrets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "instructions": {
            "type": "string",
            "default": ""
          },
          "preflight": {
            "$ref": "#/$defs/preflightRecipe"
          }
        }
      },
      "default": {}
    },
    "vessels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "model"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "runtime": {
            "type": "string",
            "minLength": 1
          },
          "rigging": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          }
        }
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "vessels"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "course": {
            "type": "string",
            "minLength": 1
          },
          "vessels": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "default": []
    }
  }
}
