{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yacht.dev/schemas/yacht.regatta.v1.schema.json",
  "title": "YACHT Regatta",
  "type": "object",
  "additionalProperties": false,
  "required": ["regatta", "course", "vessels"],
  "$defs": {
    "preflightCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "agent-prompt",
            "artifact",
            "command",
            "env",
            "mcp-server",
            "path-isolation",
            "runtime-capability",
            "tool-call"
          ]
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "env": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "expect_tool_calls": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      }
    },
    "preflightRecipe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean",
          "default": true
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/preflightCheck"
          },
          "default": []
        }
      },
      "default": {}
    },
    "riggingInstallStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "target"],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "agent-extension",
            "mcp-server",
            "package",
            "binary",
            "container-image",
            "preinstalled",
            "custom-command"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "package": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      }
    },
    "expectResponse": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": ["string", "boolean", "integer", "number"]
      }
    }
  },
  "properties": {
    "regatta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "not": {
        "anyOf": [
          {
            "required": ["tasks", "task_file"]
          },
          {
            "required": ["tasks", "task_files"]
          },
          {
            "required": ["task_file", "task_files"]
          }
        ]
      },
      "anyOf": [
        {
          "required": ["tasks"],
          "properties": {
            "tasks": {
              "minItems": 1
            }
          }
        },
        {
          "required": ["task_file"]
        },
        {
          "required": ["task_files"]
        },
        {
          "required": ["adapter"],
          "properties": {
            "adapter": {
              "required": ["instance_ids"]
            }
          }
        }
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "task_file": {
          "type": "string",
          "minLength": 1
        },
        "task_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tasks": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "difficulty": {
                "type": "integer",
                "minimum": 1,
                "default": 1
              },
              "repo": {
                "type": "string",
                "minLength": 1
              },
              "repo_url": {
                "type": "string",
                "minLength": 1
              },
              "base_commit": {
                "type": "string",
                "minLength": 1
              },
              "problem_statement": {
                "type": "string",
                "minLength": 1
              },
              "expect_response": {
                "$ref": "#/$defs/expectResponse"
              },
              "expect_tool_calls": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "default": []
              }
            }
          }
        },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "dataset", "split", "harness"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["custom-eval", "swe-bench"]
            },
            "dataset": {
              "type": "string",
              "minLength": 1
            },
            "split": {
              "type": "string",
              "minLength": 1
            },
            "harness": {
              "type": "string",
              "enum": ["docker", "local"]
            },
            "instance_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "failure_policy": {
          "type": "string",
          "enum": ["abort-group", "skip-vessel", "abort-regatta", "warn"],
          "default": "abort-group"
        }
      },
      "default": {}
    },
    "secrets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source"],
        "properties": {
          "source": {
            "type": "string",
            "enum": ["env", "file"]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "source": {
                  "const": "env"
                }
              }
            },
            "then": {
              "required": ["name"]
            }
          },
          {
            "if": {
              "properties": {
                "source": {
                  "const": "file"
                }
              }
            },
            "then": {
              "required": ["path"]
            }
          }
        ]
      },
      "default": {}
    },
    "tools": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "interfaces": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "install_methods": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "agent-extension",
                "mcp-server",
                "package",
                "binary",
                "container-image",
                "preinstalled",
                "custom-command"
              ]
            },
            "default": []
          },
          "expected_tool_calls": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          }
        }
      },
      "default": {}
    },
    "runtimes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["backend", "command"],
        "properties": {
          "backend": {
            "type": "string",
            "enum": ["container", "host-nix"]
          },
          "flake": {
            "type": "string",
            "minLength": 1
          },
          "image": {
            "type": "string",
            "minLength": 1
          },
          "container_home": {
            "type": "string",
            "pattern": "^/",
            "default": "/home/yacht"
          },
          "container_workspace": {
            "type": "string",
            "pattern": "^/",
            "default": "/workspace"
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "harness": {
            "type": "string",
            "minLength": 1
          },
          "agent": {
            "type": "string",
            "minLength": 1
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "default": {}
          },
          "required_secrets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "mounts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "preflight": {
            "$ref": "#/$defs/preflightRecipe"
          }
        }
      },
      "default": {}
    },
    "riggings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "install": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "$ref": "#/$defs/riggingInstallStep"
                }
              ]
            },
            "default": []
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "default": {}
          },
          "required_secrets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "instructions": {
            "type": "string",
            "default": ""
          },
          "preflight": {
            "$ref": "#/$defs/preflightRecipe"
          }
        }
      },
      "default": {}
    },
    "vessels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "model"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "runtime": {
            "type": "string",
            "minLength": 1
          },
          "rigging": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          }
        }
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "vessels"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "course": {
            "type": "string",
            "minLength": 1
          },
          "vessels": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "default": []
    }
  }
}
