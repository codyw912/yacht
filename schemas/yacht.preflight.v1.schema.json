{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yacht.dev/schemas/yacht.preflight.v1.schema.json",
  "title": "YACHT Preflight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "regatta",
    "vessel",
    "runtime",
    "workspace_path",
    "temp_home",
    "command_prefix",
    "cleanup_paths",
    "status",
    "failure_policy",
    "secret_refs",
    "checks"
  ],
  "properties": {
    "schema": {
      "const": "yacht.preflight.v1"
    },
    "regatta": {
      "type": "string",
      "minLength": 1
    },
    "comparison": {
      "type": "string",
      "minLength": 1
    },
    "vessel": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "type": "string",
      "minLength": 1
    },
    "workspace_path": {
      "type": "string",
      "minLength": 1
    },
    "temp_home": {
      "type": "string",
      "minLength": 1
    },
    "command_prefix": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cleanup_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "type": "string",
      "enum": ["passed", "failed", "error", "skipped"]
    },
    "failure_policy": {
      "type": "string",
      "enum": ["abort-group", "skip-vessel", "abort-regatta", "warn"]
    },
    "secret_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source", "ref", "redacted"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "enum": ["env", "file"]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "redacted": {
            "const": true
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "origin",
          "origin_name",
          "required",
          "status",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "agent-prompt",
              "artifact",
              "command",
              "env",
              "mcp-server",
              "path-isolation",
              "tool-call"
            ]
          },
          "origin": {
            "type": "string",
            "enum": ["runtime", "rigging"]
          },
          "origin_name": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "error", "skipped"]
          },
          "evidence": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "prompt": {
                "type": "string"
              },
              "tool_calls": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              }
            }
          }
        }
      }
    }
  }
}
