{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yacht.dev/schemas/yacht.course-handoff.v1.schema.json",
  "title": "YACHT Course Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "regatta",
    "course",
    "status",
    "adapter",
    "tasks",
    "comparisons",
    "expected_outputs",
    "grading"
  ],
  "properties": {
    "schema": {
      "const": "yacht.course-handoff.v1"
    },
    "regatta": {
      "type": "string",
      "minLength": 1
    },
    "course": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "planned"
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "dataset", "split", "harness"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["custom-eval", "swe-bench"]
        },
        "dataset": {
          "type": "string",
          "minLength": 1
        },
        "split": {
          "type": "string",
          "minLength": 1
        },
        "harness": {
          "type": "string",
          "enum": ["docker", "local"]
        },
        "instance_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "difficulty"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "difficulty": {
            "type": "integer",
            "minimum": 1
          },
          "repo": {
            "type": "string",
            "minLength": 1
          },
          "base_commit": {
            "type": "string",
            "minLength": 1
          },
          "problem_statement": {
            "type": "string",
            "minLength": 1
          },
          "expect_response": {
            "$ref": "#/$defs/expectResponse"
          }
        }
      }
    },
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "course", "vessels"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "course": {
            "type": "string",
            "minLength": 1
          },
          "vessels": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "expected_outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_patches", "grading_report"],
      "properties": {
        "candidate_patches": {
          "type": "string",
          "minLength": 1
        },
        "grading_report": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "grading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delegated_to", "execution", "status"],
      "properties": {
        "delegated_to": {
          "type": "string",
          "enum": ["swe-bench"]
        },
        "execution": {
          "type": "string",
          "enum": ["docker-harness", "local-harness"]
        },
        "status": {
          "const": "planned"
        }
      }
    }
  },
  "$defs": {
    "expectResponse": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": ["string", "boolean", "integer", "number"]
      }
    }
  }
}
