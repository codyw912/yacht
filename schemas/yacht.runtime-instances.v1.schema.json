{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yacht.dev/schemas/yacht.runtime-instances.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "regatta",
    "course",
    "mode",
    "workspace_path",
    "comparisons"
  ],
  "properties": {
    "schema": {
      "const": "yacht.runtime-instances.v1"
    },
    "regatta": {
      "type": "string",
      "minLength": 1
    },
    "course": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "const": "dry-run"
    },
    "workspace_path": {
      "type": "string",
      "minLength": 1
    },
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/comparison"
      }
    }
  },
  "$defs": {
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "course",
        "vessels"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "course": {
          "type": "string",
          "minLength": 1
        },
        "vessels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/vessel"
          }
        }
      }
    },
    "vessel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "runtime",
        "backend",
        "trial_root",
        "temp_home",
        "workspace_path",
        "command_prefix",
        "command",
        "env",
        "secret_refs",
        "cleanup_paths"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "backend": {
          "type": "string",
          "minLength": 1
        },
        "trial_root": {
          "type": "string",
          "minLength": 1
        },
        "temp_home": {
          "type": "string",
          "minLength": 1
        },
        "workspace_path": {
          "type": "string",
          "minLength": 1
        },
        "command_prefix": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "command": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "secret_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/secretRef"
          }
        },
        "cleanup_paths": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "secretRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source",
        "ref",
        "redacted"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "redacted": {
          "const": true
        }
      }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
