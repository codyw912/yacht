{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yacht.dev/schemas/yacht.task-attempt-scorecard.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "regatta",
    "course",
    "status",
    "summary",
    "comparisons"
  ],
  "properties": {
    "schema": {
      "const": "yacht.task-attempt-scorecard.v1"
    },
    "regatta": {
      "type": "string",
      "minLength": 1
    },
    "course": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "complete",
        "partial"
      ]
    },
    "summary": {
      "$ref": "#/$defs/topLevelSummary"
    },
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/comparison"
      }
    }
  },
  "$defs": {
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "summary",
        "vessels"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "$ref": "#/$defs/summary"
        },
        "vessels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/vessel"
          }
        }
      }
    },
    "vessel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "task_attempts",
        "completed_attempts",
        "failed_attempts",
        "success_rate",
        "tool_call_count",
        "total_tokens",
        "total_duration_seconds",
        "artifact_paths"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "measured",
            "failed"
          ]
        },
        "task_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "completed_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "failed_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "success_rate": {
          "type": "number",
          "minimum": 0
        },
        "harnesses": {
          "$ref": "#/$defs/stringArray"
        },
        "tool_call_count": {
          "type": "integer",
          "minimum": 0
        },
        "tool_call_counts": {
          "$ref": "#/$defs/toolCallCounts"
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_cost": {
          "type": "number",
          "minimum": 0
        },
        "total_duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "artifact_paths": {
          "$ref": "#/$defs/stringArray"
        },
        "provenance": {
          "$ref": "#/$defs/collapsedProvenance"
        }
      }
    },
    "collapsedProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "yacht",
        "harness",
        "model",
        "runtime",
        "tools",
        "mixed"
      ],
      "properties": {
        "yacht": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version"
          ],
          "properties": {
            "version": {
              "$ref": "#/$defs/nullableString"
            }
          }
        },
        "harness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/nullableString"
            },
            "version": {
              "$ref": "#/$defs/nullableString"
            }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "configured",
            "resolved"
          ],
          "properties": {
            "configured": {
              "$ref": "#/$defs/nullableString"
            },
            "resolved": {
              "$ref": "#/$defs/nullableString"
            }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "backend",
            "image"
          ],
          "properties": {
            "backend": {
              "$ref": "#/$defs/nullableString"
            },
            "image": {
              "$ref": "#/$defs/nullableString"
            }
          }
        },
        "tools": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "tools",
                  "version",
                  "source"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "tools": {
                    "$ref": "#/$defs/stringArray"
                  },
                  "version": {
                    "$ref": "#/$defs/nullableString"
                  },
                  "source": {
                    "$ref": "#/$defs/nullableString"
                  }
                }
              }
            }
          ]
        },
        "mixed": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "nullableString": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "topLevelSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_comparisons",
        "total_vessels",
        "total_attempts",
        "completed_attempts",
        "failed_attempts",
        "total_tool_calls",
        "total_tokens",
        "total_duration_seconds"
      ],
      "properties": {
        "total_comparisons": {
          "type": "integer",
          "minimum": 0
        },
        "total_vessels": {
          "type": "integer",
          "minimum": 0
        },
        "total_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "completed_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "failed_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "total_tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "tool_call_counts": {
          "$ref": "#/$defs/toolCallCounts"
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_cost": {
          "type": "number",
          "minimum": 0
        },
        "total_duration_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_vessels",
        "total_attempts",
        "completed_attempts",
        "failed_attempts",
        "total_tool_calls",
        "total_tokens",
        "total_duration_seconds"
      ],
      "properties": {
        "total_vessels": {
          "type": "integer",
          "minimum": 0
        },
        "total_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "completed_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "failed_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "total_tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "tool_call_counts": {
          "$ref": "#/$defs/toolCallCounts"
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_cost": {
          "type": "number",
          "minimum": 0
        },
        "total_duration_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "toolCallCounts": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
